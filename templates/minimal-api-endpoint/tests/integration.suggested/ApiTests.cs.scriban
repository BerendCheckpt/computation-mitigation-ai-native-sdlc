using {{ project }}.Features.{{ entity | plural }};
using Microsoft.AspNetCore.Mvc.Testing;

namespace {{ project }}.IntegrationTests.Features.{{ entity | plural }};

public class {{ entity }}ApiTests(WebApplicationFactory<Program> factory) : IClassFixture<WebApplicationFactory<Program>>
{
    readonly HttpClient _client = factory.CreateClient();

    [Fact]
    public async Task Post_then_get_roundtrips()
    {
        var post = await _client.PostAsJsonAsync("{{ route }}", new Create{{ entity }}Request("Integration"));
        Assert.Equal(HttpStatusCode.Created, post.StatusCode);
        Assert.NotNull(post.Headers.Location);

        var created = await post.Content.ReadFromJsonAsync<{{ entity }}>();
        var get = await _client.GetFromJsonAsync<{{ entity }}>($"{{ route }}/{created!.Id}");

        Assert.Equal("Integration", get!.Name);
    }

    [Fact]
    public async Task Post_without_name_is_rejected()
    {
        var post = await _client.PostAsJsonAsync("{{ route }}", new Create{{ entity }}Request(""));
        Assert.Equal(HttpStatusCode.BadRequest, post.StatusCode);
    }

    [Fact]
    public async Task Delete_unknown_returns_404()
    {
        var delete = await _client.DeleteAsync($"{{ route }}/{Guid.NewGuid()}");
        Assert.Equal(HttpStatusCode.NotFound, delete.StatusCode);
